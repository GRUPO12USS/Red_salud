import { Component, Inject, LOCALE_ID, OnInit } from '@angular/core';
import { MAT_DIALOG_DATA, MatDialog, MatDialogModule, MatDialogRef } from '@angular/material/dialog';
import { FormBuilder, FormGroup, ReactiveFormsModule, Validators } from '@angular/forms';
import { MatInputModule } from '@angular/material/input';
import { MatNativeDateModule } from '@angular/material/core';
import { MatDatepickerModule } from '@angular/material/datepicker';
import { MatFormFieldModule } from '@angular/material/form-field';
import { Router } from '@angular/router';
import { CommonModule, registerLocaleData } from '@angular/common';
import localeEsCL from '@angular/common/locales/es-CL';
import { provideNativeDateAdapter } from '@angular/material/core';
import { MatButtonModule } from '@angular/material/button';
import { MatIconModule } from '@angular/material/icon';
import { MatSelectModule } from '@angular/material/select';
import { ConfirmDialogComponent } from '../../confirm-dialog/confirm-dialog.component';
import { Box } from '../../models/box.model';
import { Especialista, EspecialistaService } from '../../services/especialista.service';
import { BoxService } from '../../services/box.service';
import { MatAutocompleteModule } from '@angular/material/autocomplete';
import { MatOptionModule } from '@angular/material/core';
import { map, Observable, startWith } from 'rxjs';
import { BrowserAnimationsModule } from '@angular/platform-browser/animations';
import { OfertaEspecialista, OfertaService } from '../../services/oferta.service';
import { HorarioEspecialistaService } from '../../services/horario-especialista.service';

registerLocaleData(localeEsCL);

@Component({
  standalone: true,
  selector: 'app-asignar-horario-dialog-especialista',
  imports: [
    CommonModule,
    MatDialogModule,
    MatFormFieldModule,
    MatInputModule,
    MatDatepickerModule,
    MatNativeDateModule,
    ReactiveFormsModule,
    MatButtonModule,
    MatIconModule,
    MatSelectModule,
    MatAutocompleteModule,
    MatOptionModule,
  ],
  templateUrl: './asignar-horario-dialog-especialista.component.html',
  styleUrls: ['./asignar-horario-dialog-especialista.component.css'],
  providers: [
    { provide: LOCALE_ID, useValue: 'es-CL' },
    provideNativeDateAdapter(),
  ],
})
export class AsignarHorarioDialogEspecialistaComponent implements OnInit {
  formulario: FormGroup;
  minDate = new Date();
  pisoAutoDetectado: number | '' = '';
  mensajeAdvertencia: string = '';
  especialistas: Especialista[] = [];
  boxes: Box[] = [];
  ofertas: OfertaEspecialista[] = [];
  ofertasFiltradas: Observable<Especialista[]> = new Observable<Especialista[]>();

  constructor(
    private fb: FormBuilder,
    public dialogRef: MatDialogRef<AsignarHorarioDialogEspecialistaComponent>,
    @Inject(MAT_DIALOG_DATA) public data: any,
    private router: Router,
    private dialog: MatDialog,
    private especialistaService: EspecialistaService,
    private boxService: BoxService,
    private ofertaService: OfertaService,
    private horarioService: HorarioEspecialistaService,
  ) {
    this.formulario = this.fb.group({
      especialista: ['', Validators.required],
      especialidad: [{ value: '', disabled: true }],
      fecha: ['', Validators.required],
      horaInicio: ['', Validators.required],
      horaFin: ['', Validators.required],
      box: ['', Validators.required],
      piso: [{ value: '', disabled: false }, Validators.required],
    });
  }
    this.formulario = this.fb.group({
      especialista: ['', Validators.required],
      especialidad: [null, Validators.required],
      box: [null, [Validators.required, Validators.pattern(/^\d+$/)]],
      piso: [null, Validators.required],
      fecha: [null, Validators.required],
      horaInicio: [null, Validators.required],
      horaFin: [null, Validators.required],
    });
  }

  ngOnInit(): void {
    // Cargar solo ofertas disponibles
    this.ofertaService.getOfertas({ estado: 'Disponible' }).subscribe({
      next: (res) => {
        console.log('Ofertas disponibles cargadas:', res);
        this.ofertas = res.filter(oferta => oferta.estado === 'Disponible');
      },
      error: (err) => console.error('Error al cargar ofertas', err)
    });

    // Cargar solo boxes disponibles
    this.boxService.getDisponibles().subscribe({
      next: (res) => {
        this.boxes = res.filter(box => box.estado === 'disponible');
        console.log('Boxes disponibles:', this.boxes);
      },
      error: (err) => console.error('Error al cargar boxes', err)
    });

    // Cuando cambia el especialista, cargar su información y validar horarios
    this.formulario.get('especialista')?.valueChanges.subscribe(especialistaId => {
      const oferta = this.ofertas.find(o => o.especialista.id === especialistaId);
      if (oferta) {
        this.formulario.patchValue({ 
          especialidad: oferta.especialista.especialidad 
        }, { emitEvent: false });
        
        // Filtrar boxes del piso del especialista
        const boxesDelPiso = this.boxes.filter(b => b.piso === oferta.piso);
        console.log(`Boxes disponibles en piso ${oferta.piso}:`, boxesDelPiso);
      }
    });

    // Auto-detectar piso según box seleccionado
    this.formulario.get('box')?.valueChanges.subscribe(boxNumero => {
      const box = this.boxes.find(b => b.numero === Number(boxNumero));
      if (box) {
        this.pisoAutoDetectado = box.piso;
        this.formulario.patchValue({ piso: box.piso }, { emitEvent: false });
        this.mensajeAdvertencia = '';
      }
    });

    // Validar si el usuario modifica el piso manualmente
    this.formulario.get('piso')?.valueChanges.subscribe(pisoManual => {
      if (this.pisoAutoDetectado && pisoManual !== this.pisoAutoDetectado) {
        this.mensajeAdvertencia = `⚠️ Estás modificando el piso detectado automáticamente (${this.pisoAutoDetectado}).`;
      } else {
        this.mensajeAdvertencia = '';
      }
    });

    // Validar horarios cuando cambian
    this.formulario.get('horaInicio')?.valueChanges.subscribe(() => this.validarHorariosEnRango());
    this.formulario.get('horaFin')?.valueChanges.subscribe(() => this.validarHorariosEnRango());
    this.formulario.get('especialista')?.valueChanges.subscribe(() => this.validarHorariosEnRango());
  }

  validarHorariosEnRango(): void {
    const especialistaId = this.formulario.get('especialista')?.value;
    const horaInicio = this.formulario.get('horaInicio')?.value;
    const horaFin = this.formulario.get('horaFin')?.value;

    if (!especialistaId || !horaInicio || !horaFin) {
      this.mensajeAdvertencia = '';
      return;
    }

    const oferta = this.ofertas.find(o => o.especialista.id === especialistaId);
    if (!oferta || !oferta.horario_disponible) {
      this.mensajeAdvertencia = '';
      return;
    }

    // Parsear el horario disponible de la oferta
    const horarios = oferta.horario_disponible.split('-').map(h => h.trim());
    if (horarios.length !== 2) {
      this.mensajeAdvertencia = '';
      return;
    }

    const [rangoInicio, rangoFin] = horarios;

    // Validar que los horarios estén dentro del rango
    if (horaInicio < rangoInicio || horaFin > rangoFin || horaFin <= horaInicio) {
      this.mensajeAdvertencia = `⚠️ El horario debe estar entre ${rangoInicio} y ${rangoFin}, y la hora fin debe ser posterior a la hora inicio.`;
    } else {
      this.mensajeAdvertencia = '';
    }
  }

  getBoxesDisponiblesParaEspecialista(): Box[] {
    const especialistaId = this.formulario.get('especialista')?.value;
    if (!especialistaId) {
      return [];
    }

    const oferta = this.ofertas.find(o => o.especialista.id === especialistaId);
    if (!oferta) {
      return [];
    }

    // Filtrar boxes del mismo piso que la oferta y que estén disponibles
    return this.boxes.filter(box => box.piso === oferta.piso && box.estado === 'disponible');
  }

  obtenerPisoPorBox(box: string): string {
    if (!box) return '';

    const match = String(box).match(/^(\d+)/);
    if (!match) return '';

    const numeroStr = match[1];
    const length = numeroStr.length;

    let piso = '';

    if (length >= 4) {
      piso = numeroStr.substring(0, 2);
    } else if (length === 3) {
      piso = numeroStr.substring(0, 1);
    } else if (length <= 2) {
      piso = '1';
    }

    return piso;
  }

  actualizarMensajeAdvertencia(): void {
    const pisoManual = this.formulario.get('piso')?.value;
    if (this.pisoAutoDetectado !== null && pisoManual && +pisoManual !== this.pisoAutoDetectado) {
      this.mensajeAdvertencia = `⚠️ El número ingresado sugiere que este box está en el piso ${this.pisoAutoDetectado}, pero se seleccionó el piso ${pisoManual}.`;
    } else {
      this.mensajeAdvertencia = '';
    }
  }

  async cancelar() {
    const dialogRef = this.dialog.open(ConfirmDialogComponent, {
      width: '350px',
      data: {
        titulo: 'Cancelar',
        mensaje: '¿Seguro que deseas cancelar? Se perderán los cambios.'
      }
    });

    const confirmado = await dialogRef.afterClosed().toPromise();
    if (confirmado) {
      this.dialogRef.close();
    }
  }

  guardar(): void {
  if (this.formulario.invalid) {
    return;
  }

  const formValue = this.formulario.value;

  const payload = {
    especialista: formValue.especialista,  // ID numérico
    box: formValue.box,                    // ID numérico
    fecha: formValue.fecha.toISOString().split('T')[0],  // convertir a 'YYYY-MM-DD'
    hora_inicio: formValue.horaInicio,    // 'HH:MM'
    hora_fin: formValue.horaFin,           // 'HH:MM'
    disponible: true                       // opcional, puedes enviarlo
  };

  console.log('Payload a enviar:', payload);

  this.horarioService.crearHorario(payload).subscribe({
    next: (nuevoHorario) => {
      this.dialogRef.close(nuevoHorario);
    },
    error: (err) => {
      console.error('Error al crear horario:', err);
    }
  });
}



  onWheel(event: WheelEvent): void {
    (event.target as HTMLInputElement).blur();
    event.preventDefault();
  }



}


